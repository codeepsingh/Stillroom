# Public build-time configuration. Never put secrets in VITE_* variables.
# Preview is the default. Use Preprod for Level 2–4 release evidence.
VITE_NETWORK=preview
VITE_CONTRACT_ADDRESS=

# Optional per-network addresses; browser-saved values take priority.
# VITE_PREVIEW_CONTRACT_ADDRESS=
# VITE_PREPROD_CONTRACT_ADDRESS=
