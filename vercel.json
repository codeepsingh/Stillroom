{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "routes": [
    { "src": "/(.*)", "headers": { "X-Content-Type-Options": "nosniff", "Referrer-Policy": "no-referrer", "X-Frame-Options": "DENY" }, "continue": true },
    { "handle": "filesystem" },
    { "src": "/managed/(.*)", "status": 404 },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
