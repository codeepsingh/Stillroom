pragma language_version >=0.22.0;

import CompactStandardLibrary;

// Public gate configuration. Every exported ledger field is readable on-chain.
export ledger entry_threshold: Uint<64>;
export ledger access_pass_id: Bytes<32>;
export ledger entry_deadline: Uint<64>;
export ledger curator_id: Bytes<32>;
export sealed ledger steward: Bytes<32>;
export ledger gate_open: Boolean;
export ledger total_entries: Counter;
export ledger entry_limit: Uint<32>;
export ledger used_nullifiers: Set<Bytes<32>>;
// Pass identifiers are never reused, even after a rotation.
export ledger used_pass_ids: Set<Bytes<32>>;
export ledger entry_log: Map<Bytes<32>, Bytes<32>>;
export sealed ledger edition: Bytes<32>;

// Private to the on-chain transcript, not necessarily to a remote proving service.
// The score is self-attested: no issuer signature or unique-person check exists.
witness get_eligibility_score(): Uint<64>;
witness get_passphrase(): Bytes<32>;
witness steward_secret(): Bytes<32>;

constructor(
    threshold: Uint<64>,
    pass: Bytes<32>,
    deadline: Uint<64>,
    curator: Bytes<32>,
    steward_hash: Bytes<32>,
    limit: Uint<32>
) {
    assert(threshold <= 100, "Threshold must be between 0 and 100");
    assert(limit > 0, "Entry capacity must be positive");
    assert(deadline > 0, "Deadline must be positive");
    assert(pass != default<Bytes<32>>, "Pass identifier must be nonzero");
    assert(steward_hash != default<Bytes<32>>, "Steward commitment must be nonzero");
    used_pass_ids.insert(disclose(pass));
    entry_threshold = disclose(threshold);
    access_pass_id = disclose(pass);
    entry_deadline = disclose(deadline);
    curator_id = disclose(curator);
    steward = disclose(steward_hash);
    gate_open = disclose(true);
    entry_limit = disclose(limit);
    edition = disclose(pad(32, "Stillroom:v1.0"));
}

// Proves a private eligibility score clears the public threshold.
export circuit prove_entry(): [] {
    assert(disclose(gate_open), "The gate is closed");
    assert(blockTimeLt(disclose(entry_deadline)), "This pass has expired");
    assert(disclose(total_entries) < disclose(entry_limit), "Entry capacity reached");

    const score = get_eligibility_score();
    assert(score <= 100, "Score must be between 0 and 100");
    assert(score >= entry_threshold, "Eligibility threshold not met");

    const passphrase = get_passphrase();
    const nullifier = make_entry_nullifier(passphrase, access_pass_id);
    assert(!used_nullifiers.member(disclose(nullifier)), "This pass has already been used");

    used_nullifiers.insert(disclose(nullifier));
    entry_log.insert(disclose(nullifier), disclose(access_pass_id));
    total_entries.increment(1);
}

// Steward-only gate configuration. The private key is never submitted as an argument.
export circuit rotate_gate(
    new_threshold: Uint<64>,
    new_pass: Bytes<32>,
    new_deadline: Uint<64>,
    new_curator: Bytes<32>,
    new_limit: Uint<32>
): [] {
    const sk = steward_secret();
    assert(steward == steward_public_key(sk), "Not authorized as steward");
    assert(new_threshold <= 100, "Threshold must be between 0 and 100");
    // Capacity is lifetime-wide; rotation never erases the audit history.
    assert(disclose(new_limit) > total_entries, "Capacity must exceed lifetime entries");
    assert(blockTimeLt(disclose(new_deadline)), "New deadline must be in the future");
    assert(new_pass != default<Bytes<32>>, "Pass identifier must be nonzero");
    assert(!used_pass_ids.member(disclose(new_pass)), "Pass identifier already used");
    used_pass_ids.insert(disclose(new_pass));
    entry_threshold = disclose(new_threshold);
    access_pass_id = disclose(new_pass);
    entry_deadline = disclose(new_deadline);
    curator_id = disclose(new_curator);
    entry_limit = disclose(new_limit);
    gate_open = disclose(true);
}

export circuit close_gate(): [] {
    const sk = steward_secret();
    assert(steward == steward_public_key(sk), "Not authorized as steward");
    gate_open = disclose(false);
}

export circuit open_gate(): [] {
    const sk = steward_secret();
    assert(steward == steward_public_key(sk), "Not authorized as steward");
    assert(blockTimeLt(disclose(entry_deadline)), "This pass has expired");
    assert(disclose(total_entries) < disclose(entry_limit), "Entry capacity reached");
    gate_open = disclose(true);
}

export pure circuit steward_public_key(sk: Bytes<32>): Bytes<32> {
    return persistentHash<Vector<2, Bytes<32>>>([pad(32, "stillroom:steward:v1"), sk]);
}

export pure circuit make_entry_nullifier(passphrase: Bytes<32>, pass: Bytes<32>): Bytes<32> {
    return persistentHash<Vector<3, Bytes<32>>>([
        pad(32, "stillroom:nullifier:v1"),
        passphrase,
        pass
    ]);
}
